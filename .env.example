# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
# Obtain from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (Keep private! Only used on backend for cron jobs/admin)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# CRON SECRET
# ==========================================
# Secure token to authenticate scheduled cron triggers (/api/cron/*)
CRON_SECRET=your-random-secure-cron-secret

# ==========================================
# META WHATSAPP BUSINESS CLOUD API
# ==========================================
# Obtain from Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v20.0

# Optional template names (defaults provided in code)
WHATSAPP_PURCHASE_TEMPLATE=purchase_summary_v1
WHATSAPP_REMINDER_TEMPLATE=payment_reminder_v1
WHATSAPP_PAYMENT_RECEIVED_TEMPLATE=payment_received_v1

# Enable mock mode explicitly if desired (automatically active if tokens are omitted in dev)
# NEXT_PUBLIC_WHATSAPP_MOCK=true
